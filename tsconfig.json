{
  "extends": "@vue/tsconfig/tsconfig.json",
  "compilerOptions": {
    "paths": {
      "@/*": [
        "./src/*",
      ]
    },
    "types": [
      "vite/client",
      "naive-ui/volar",
    ],
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable",
    ],
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.vue",
  ],
  "exclude": [
    "node_modules",
    "src-tauri",
  ],
}
